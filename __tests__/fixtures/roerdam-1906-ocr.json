{
  "engine": "tesseract 5.5.1, dan, psm 3",
  "pages": {
    "012.jpg": [
      {"page": 1, "left": 357, "top": 356, "width": 400, "height": 31, "text": "STUMME STRÆNGE"},
      {"page": 1, "left": 222, "top": 475, "width": 635, "height": 86, "text": "O har du leget din Luth så længe"},
      {"page": 1, "left": 329, "top": 534, "width": 608, "height": 43, "text": "for døve Øren på stumme Strænge —"},
      {"page": 1, "left": 217, "top": 740, "width": 611, "height": 33, "text": "En halv Mils Vej ud i Verdensrummet"},
      {"page": 1, "left": 217, "top": 804, "width": 554, "height": 33, "text": "er hele Jordens Musik forstummet."},
      {"page": 1, "left": 212, "top": 993, "width": 585, "height": 35, "text": "Ja, selv i Syvstjærnens Søsterklynge"},
      {"page": 1, "left": 217, "top": 1057, "width": 507, "height": 34, "text": "kan ingen høre de andre synge."},
      {"page": 1, "left": 217, "top": 1246, "width": 575, "height": 34, "text": "Men alle synger endda. Det trøster:"},
      {"page": 1, "left": 218, "top": 1309, "width": 634, "height": 35, "text": "Histovre vandrer med Sang min Søster."},
      {"page": 1, "left": 225, "top": 1359, "width": 660, "height": 22, "text": "Stumme Strænge 1"}
    ],
    "013.jpg": [
      {"page": 1, "left": 436, "top": 183, "width": 640, "height": 34, "text": "Og Himlens Skaber og Gud fornemmer"},
      {"page": 1, "left": 435, "top": 247, "width": 665, "height": 34, "text": "i gylden Samklang de klare Stemmer. —"},
      {"page": 1, "left": 436, "top": 430, "width": 615, "height": 34, "text": "Hvad vil du, Myg? Når dit eget Indre"},
      {"page": 1, "left": 437, "top": 495, "width": 599, "height": 34, "text": "dog hører Tonernes Dråber tindre ..."},
      {"page": 1, "left": 438, "top": 677, "width": 703, "height": 34, "text": "Hvad vil du, Stjærne? Blot Faklen flammer"},
      {"page": 1, "left": 437, "top": 741, "width": 620, "height": 35, "text": "sin Ildsang højt i dit eget Kammer..."},
      {"page": 1, "left": 438, "top": 925, "width": 653, "height": 36, "text": "Du Myg, du Stjærne, du Toneknytter —"},
      {"page": 1, "left": 437, "top": 989, "width": 576, "height": 32, "text": "måske der tilmed er En, som lytter."},
      {"page": 1, "left": 439, "top": 1171, "width": 585, "height": 35, "text": "Leg du da trøstig din Luth så længe"},
      {"page": 1, "left": 438, "top": 1233, "width": 622, "height": 35, "text": "for døve Øren — på stumme Strænge."},
      {"page": 1, "left": 970, "top": 1325, "width": 127, "height": 27, "text": "23/6. 1906."}
    ],
    "018.jpg": [
      {"page": 1, "left": 471, "top": 381, "width": 121, "height": 36, "text": "JUNI"},
      {"page": 1, "left": 155, "top": 485, "width": 580, "height": 93, "text": "Je Påske, Pinse og Sankt-Hans,"},
      {"page": 1, "left": 229, "top": 551, "width": 688, "height": 33, "text": "de svinger omkring dig, — Elvernes Dans."},
      {"page": 1, "left": 156, "top": 685, "width": 540, "height": 34, "text": "En hvid, en grå, en grøn, en rød;"},
      {"page": 1, "left": 155, "top": 748, "width": 699, "height": 36, "text": "de danser, du drømmer — om Liv og Død."},
      {"page": 1, "left": 155, "top": 878, "width": 542, "height": 39, "text": "Mer ilsomt hvirvler de År for År,"},
      {"page": 1, "left": 155, "top": 946, "width": 595, "height": 33, "text": "og dybere drømmer du, hvor du står."},
      {"page": 1, "left": 155, "top": 1081, "width": 584, "height": 35, "text": "Nu duver Axet, nu dufter Rugen —"},
      {"page": 1, "left": 154, "top": 1145, "width": 677, "height": 35, "text": "snart triller et Jordbær rødt henad Dugen."},
      {"page": 1, "left": 155, "top": 1278, "width": 589, "height": 34, "text": "Nu dufter Rugen. Hvad vil du mer?"},
      {"page": 1, "left": 156, "top": 1341, "width": 681, "height": 36, "text": "Du tænker på Ting ... på Ting, som sker."}
    ],
    "019.jpg": [
      {"page": 1, "left": 315, "top": 211, "width": 572, "height": 34, "text": "På Menneskebørn, som lo bedrøvet,"},
      {"page": 1, "left": 314, "top": 275, "width": 580, "height": 34, "text": "og bøjede Nakken, og krøb i Støvet."},
      {"page": 1, "left": 315, "top": 410, "width": 586, "height": 35, "text": "Dær ligger de nede. Og du står her,"},
      {"page": 1, "left": 313, "top": 475, "width": 662, "height": 34, "text": "mens Roserne blomstrer, og Rugen drær."}
    ],
    "023.jpg": [
      {"page": 1, "left": 510, "top": 378, "width": 304, "height": 29, "text": "SEPTEMBER"},
      {"page": 1, "left": 280, "top": 499, "width": 712, "height": 82, "text": "E\" Pointer jager forbi os i luftige Spring,"},
      {"page": 1, "left": 365, "top": 564, "width": 673, "height": 33, "text": "det stænker omkring den af Roernes driv-"},
      {"page": 1, "left": 469, "top": 628, "width": 182, "height": 26, "text": "våde Blade."},
      {"page": 1, "left": 278, "top": 691, "width": 724, "height": 35, "text": "Den står; der falder et Skud — og i pilende"},
      {"page": 1, "left": 468, "top": 755, "width": 87, "height": 33, "text": "Sving"},
      {"page": 1, "left": 276, "top": 819, "width": 729, "height": 33, "text": "stryger Hønsene lavt langt bort bag om Eng-"},
      {"page": 1, "left": 467, "top": 883, "width": 218, "height": 32, "text": "gårdens Lade."},
      {"page": 1, "left": 276, "top": 1025, "width": 759, "height": 27, "text": "De vidtstrakte Stubmarker blinker. Mærk Stak-"},
      {"page": 1, "left": 466, "top": 1089, "width": 180, "height": 26, "text": "kenes Duft."},
      {"page": 1, "left": 275, "top": 1152, "width": 760, "height": 33, "text": "Langs Telefontråden kvidrer de hvilende Svaler,"},
      {"page": 1, "left": 274, "top": 1215, "width": 738, "height": 33, "text": "og Tærskemaskinerne brummer i solklar Luft."},
      {"page": 1, "left": 274, "top": 1278, "width": 759, "height": 34, "text": "Så fik vi September engang. Og Jer, kære kvid-"},
      {"page": 1, "left": 464, "top": 1342, "width": 207, "height": 31, "text": "rende Svaler,"}
    ],
    "024.jpg": [
      {"page": 1, "left": 182, "top": 175, "width": 767, "height": 43, "text": "Jer sender vi bort med al Sorgen for Somren og"},
      {"page": 1, "left": 378, "top": 249, "width": 115, "height": 25, "text": "Høsten."},
      {"page": 1, "left": 186, "top": 312, "width": 717, "height": 33, "text": "Vi slæbte os Sjælen af Livet, og tidt var det"},
      {"page": 1, "left": 377, "top": 376, "width": 88, "height": 31, "text": "slemt,"},
      {"page": 1, "left": 187, "top": 440, "width": 762, "height": 32, "text": "men flyv nu kun I til Ægypten med Klagen og"},
      {"page": 1, "left": 376, "top": 504, "width": 129, "height": 25, "text": "Trøsten!"},
      {"page": 1, "left": 168, "top": 567, "width": 745, "height": 33, "text": "»Det gik, som det kunde og skulde. Og nu er"},
      {"page": 1, "left": 378, "top": 631, "width": 156, "height": 32, "text": "det glemt."},
      {"page": 1, "left": 188, "top": 774, "width": 760, "height": 33, "text": "Flyv I til Ægypten. Her bliver så frydeligt stille."},
      {"page": 1, "left": 184, "top": 837, "width": 693, "height": 33, "text": "Jeg tænker mig om, og jeg ser mig om —"},
      {"page": 1, "left": 378, "top": 901, "width": 475, "height": 33, "text": "og jeg hører Cikaderne spille."}
    ]
  }

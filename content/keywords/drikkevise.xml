<?xml version="1.0" encoding="UTF-8"?>
<keyword id="drikkevise">
  <head>
    <title>Drikkevise</title>
    <source href="https://runeberg.org/salmonsen/2/6/0451.html"><i>Salmonsens konversationsleksikon</i>, 2. udg., 1915-1930, Bd. VI, p. 429.</source>
    <related>genrer</related>
  </head>
  <body>
    <!--
    Drikkeviser er grundlæggende betragtet <a keyword="lejlighedsdigtning">lejlighedsviser</a>, digterne skrev til sammenkomster, der gerne afsluttedes med druk. Deres temaer kredser hyppigst om besyngelse af samvær med venner, vinen og ikke mindst af livet - der er et manende »carpe diem« over de fleste: Drik og vær glad, for snart er det for sent!
    -->

    Drikkevise se <a keyword="vise"><w>Vise</w></a>.
  </body>
</keyword>

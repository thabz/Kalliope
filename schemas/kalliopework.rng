<?xml version="1.0" encoding="UTF-8"?>
<grammar xmlns="http://relaxng.org/ns/structure/1.0"
         datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">
  <start>
    <ref name="kalliopework"/>
  </start>

  <define name="mixed">
    <zeroOrMore>
      <choice>
        <text/>
        <ref name="workhead"/>
        <ref name="workbody"/>
        <ref name="textElement"/>
        <ref name="prose"/>
        <ref name="prosa"/>
        <ref name="section"/>
        <ref name="subwork"/>
        <ref name="content"/>
        <ref name="head"/>
        <ref name="body"/>
        <ref name="title"/>
        <ref name="year"/>
        <ref name="subtitle"/>
        <ref name="suptitle"/>
        <ref name="firstline"/>
        <ref name="indextitle"/>
        <ref name="toctitle"/>
        <ref name="linktitle"/>
        <ref name="breadcrumbtitle"/>
        <ref name="nofirstline"/>
        <ref name="keywords"/>
        <ref name="source"/>
        <ref name="dates"/>
        <ref name="published"/>
        <ref name="written"/>
        <ref name="performed"/>
        <ref name="event"/>
        <ref name="begivenhed"/>
        <ref name="notes"/>
        <ref name="note"/>
        <ref name="quality"/>
        <ref name="metre"/>
        <ref name="syllables"/>
        <ref name="rhyme"/>
        <ref name="structure"/>
        <ref name="pagebreaks"/>
        <ref name="pictures"/>
        <ref name="picture"/>
        <ref name="poetry"/>
        <ref name="quote"/>
        <ref name="a"/>
        <ref name="xref"/>
        <ref name="b"/>
        <ref name="i"/>
        <ref name="span"/>
        <ref name="sc"/>
        <ref name="small"/>
        <ref name="sup"/>
        <ref name="s"/>
        <ref name="u"/>
        <ref name="num"/>
        <ref name="nonum"/>
        <ref name="resetnum"/>
        <ref name="center"/>
        <ref name="right"/>
        <ref name="margin"/>
        <ref name="metrik"/>
        <ref name="wrap"/>
        <ref name="line"/>
        <ref name="br"/>
        <ref name="hr"/>
        <ref name="pb"/>
        <ref name="img"/>
        <ref name="colored"/>
        <ref name="footnote"/>
        <ref name="biblio"/>
        <ref name="asterism"/>
        <ref name="block-center"/>
        <ref name="two-columns"/>
        <ref name="column"/>
        <ref name="w"/>
      </choice>
    </zeroOrMore>
  </define>

  <define name="kalliopework">
    <element name="kalliopework">
      <attribute name="id"><text/></attribute>
      <attribute name="author"><text/></attribute>
      <optional><attribute name="status"><text/></attribute></optional>
      <optional><attribute name="type"><text/></attribute></optional>
      <optional><attribute name="parent"><text/></attribute></optional>
      <optional><attribute name="ignore-tests"><text/></attribute></optional>
      <ref name="workhead"/>
      <optional><ref name="workbody"/></optional>
    </element>
  </define>

  <define name="workhead">
    <element name="workhead">
      <interleave>
        <ref name="mixed"/>
        <optional><ref name="workheadIdentifiers"/></optional>
      </interleave>
    </element>
  </define>
  <define name="workbody"><element name="workbody"><ref name="mixed"/></element></define>

  <define name="textElement">
    <element name="text">
      <optional><attribute name="id"><text/></attribute></optional>
      <optional><attribute name="author"><text/></attribute></optional>
      <optional><attribute name="variant"><text/></attribute></optional>
      <optional><attribute name="aliases"><text/></attribute></optional>
      <optional><attribute name="skip-index"><text/></attribute></optional>
      <optional><attribute name="lang"><text/></attribute></optional>
      <optional><attribute name="ignore-tests"><text/></attribute></optional>
      <ref name="mixed"/>
    </element>
  </define>

  <define name="section">
    <element name="section">
      <optional><attribute name="id"><text/></attribute></optional>
      <optional><attribute name="author"><text/></attribute></optional>
      <optional><attribute name="level"><text/></attribute></optional>
      <optional><attribute name="variant"><text/></attribute></optional>
      <optional><attribute name="aliases"><text/></attribute></optional>
      <ref name="mixed"/>
    </element>
  </define>

  <define name="subwork">
    <element name="subwork">
      <attribute name="ref"><text/></attribute>
      <ref name="mixed"/>
    </element>
  </define>

  <define name="body">
    <element name="body">
      <optional>
        <attribute name="space" ns="http://www.w3.org/XML/1998/namespace">
          <choice>
            <value>default</value>
            <value>preserve</value>
          </choice>
        </attribute>
      </optional>
      <zeroOrMore>
        <choice>
          <ref name="poetry"/>
          <ref name="prose"/>
          <ref name="quote"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="title">
    <element name="title">
      <optional><attribute name="force-index"><text/></attribute></optional>
      <optional><attribute name="lang"><text/></attribute></optional>
      <ref name="mixed"/>
    </element>
  </define>

  <define name="firstline">
    <element name="firstline">
      <optional><attribute name="force-index"><text/></attribute></optional>
      <ref name="mixed"/>
    </element>
  </define>

  <define name="source">
    <element name="source">
      <optional><attribute name="id"><text/></attribute></optional>
      <optional><attribute name="in"><text/></attribute></optional>
      <optional><attribute name="pages"><text/></attribute></optional>
      <optional><attribute name="facsimile"><text/></attribute></optional>
      <optional><attribute name="href"><text/></attribute></optional>
      <optional><attribute name="facsimile-pages"><text/></attribute></optional>
      <optional><attribute name="facsimile-pages-num"><text/></attribute></optional>
      <optional><attribute name="facsimile-pages-offset"><text/></attribute></optional>
      <ref name="mixed"/>
      <optional><ref name="sourceIdentifiers"/></optional>
    </element>
  </define>

  <define name="note">
    <element name="note">
      <optional>
        <attribute name="space" ns="http://www.w3.org/XML/1998/namespace">
          <choice>
            <value>default</value>
            <value>preserve</value>
          </choice>
        </attribute>
      </optional>
      <optional><attribute name="type"><text/></attribute></optional>
      <optional><attribute name="lang"><text/></attribute></optional>
      <optional><attribute name="unknown-original-by"><text/></attribute></optional>
      <ref name="mixed"/>
    </element>
  </define>

  <define name="picture">
    <element name="picture">
      <optional><attribute name="src"><text/></attribute></optional>
      <optional><attribute name="type"><text/></attribute></optional>
      <optional><attribute name="year"><text/></attribute></optional>
      <optional><attribute name="artwork"><text/></attribute></optional>
      <optional><attribute name="museum"><text/></attribute></optional>
      <optional><attribute name="invnr"><text/></attribute></optional>
      <optional><attribute name="objid"><text/></attribute></optional>
      <ref name="mixed"/>
      <optional><ref name="pictureIdentifiers"/></optional>
    </element>
  </define>

  <define name="sourceIdentifiers">
    <element name="identifiers">
      <optional><ref name="wikidataIdentifier"/></optional>
      <optional><ref name="kbAlmaIdentifier"/></optional>
      <optional><ref name="dbcPidIdentifier"/></optional>
      <optional><ref name="openlibraryEditionIdentifier"/></optional>
    </element>
  </define>

  <define name="pictureIdentifiers">
    <element name="identifiers">
      <optional><ref name="wikidataIdentifier"/></optional>
      <optional><ref name="smkIdentifier"/></optional>
      <optional><ref name="kidIdentifier"/></optional>
    </element>
  </define>

  <define name="workheadIdentifiers">
    <element name="identifiers">
      <optional><ref name="wikidataIdentifier"/></optional>
      <optional><ref name="dbcWorkIdentifier"/></optional>
      <optional><ref name="openlibraryWorkIdentifier"/></optional>
      <optional><ref name="dansklitteraturshistorieIdentifier"/></optional>
      <optional><ref name="runebergBookIdentifier"/></optional>
    </element>
  </define>

  <define name="wikidataIdentifier">
    <element name="wikidata"><text/></element>
  </define>
  <define name="dbcWorkIdentifier"><element name="dbc-work"><text/></element></define>
  <define name="openlibraryWorkIdentifier"><element name="openlibrary-work"><text/></element></define>
  <define name="dansklitteraturshistorieIdentifier"><element name="dansklitteraturshistorie-lex-dk"><text/></element></define>
  <define name="runebergBookIdentifier"><element name="runeberg-book"><text/></element></define>
  <define name="kbAlmaIdentifier"><element name="kb-alma"><text/></element></define>
  <define name="dbcPidIdentifier"><element name="dbc-pid"><text/></element></define>
  <define name="openlibraryEditionIdentifier"><element name="openlibrary-edition"><text/></element></define>
  <define name="smkIdentifier"><element name="smk"><text/></element></define>
  <define name="kidIdentifier"><element name="kid"><text/></element></define>

  <define name="poetry">
    <element name="poetry">
      <optional><attribute name="font-size"><text/></attribute></optional>
      <ref name="mixed"/>
    </element>
  </define>

  <define name="prose">
    <element name="prose">
      <optional><attribute name="id"><text/></attribute></optional>
      <optional><attribute name="author"><text/></attribute></optional>
      <optional><attribute name="variant"><text/></attribute></optional>
      <optional><attribute name="aliases"><text/></attribute></optional>
      <optional><attribute name="skip-index"><text/></attribute></optional>
      <optional><attribute name="lang"><text/></attribute></optional>
      <optional><attribute name="ignore-tests"><text/></attribute></optional>
      <optional><attribute name="font-size"><text/></attribute></optional>
      <ref name="mixed"/>
    </element>
  </define>

  <define name="quote">
    <element name="quote">
      <optional><attribute name="max-width"><text/></attribute></optional>
      <optional><attribute name="lang"><text/></attribute></optional>
      <ref name="mixed"/>
    </element>
  </define>

  <define name="a">
    <element name="a">
      <optional><attribute name="href"><text/></attribute></optional>
      <optional><attribute name="poet"><text/></attribute></optional>
      <optional><attribute name="poem"><text/></attribute></optional>
      <optional><attribute name="work"><text/></attribute></optional>
      <optional><attribute name="keyword"><text/></attribute></optional>
      <optional><attribute name="person"><text/></attribute></optional>
      <optional><attribute name="bible"><text/></attribute></optional>
      <optional><attribute name="type"><text/></attribute></optional>
      <ref name="mixed"/>
    </element>
  </define>

  <define name="xref">
    <element name="xref">
      <optional><attribute name="poem"><text/></attribute></optional>
      <optional><attribute name="bible"><text/></attribute></optional>
      <optional><attribute name="type"><text/></attribute></optional>
      <empty/>
    </element>
  </define>

  <define name="hr">
    <element name="hr">
      <optional><attribute name="width"><text/></attribute></optional>
      <ref name="mixed"/>
    </element>
  </define>

  <define name="pb">
    <element name="pb">
      <optional><attribute name="n"><text/></attribute></optional>
      <optional><attribute name="facs"><text/></attribute></optional>
      <ref name="mixed"/>
    </element>
  </define>

  <define name="img">
    <element name="img">
      <optional><attribute name="src"><text/></attribute></optional>
      <optional><attribute name="alt"><text/></attribute></optional>
      <optional><attribute name="width"><text/></attribute></optional>
      <ref name="mixed"/>
    </element>
  </define>

  <define name="colored">
    <element name="colored">
      <optional><attribute name="color"><text/></attribute></optional>
      <ref name="mixed"/>
    </element>
  </define>

  <define name="simpleElement">
    <ref name="mixed"/>
  </define>

  <define name="prosa"><element name="prosa"><ref name="simpleElement"/></element></define>
  <define name="content"><element name="content"><ref name="simpleElement"/></element></define>
  <define name="head"><element name="head"><ref name="simpleElement"/></element></define>
  <define name="year"><element name="year"><ref name="simpleElement"/></element></define>
  <define name="subtitle"><element name="subtitle"><optional><attribute name="lang"><text/></attribute></optional><ref name="simpleElement"/></element></define>
  <define name="suptitle"><element name="suptitle"><ref name="simpleElement"/></element></define>
  <define name="indextitle"><element name="indextitle"><optional><attribute name="force-index"><text/></attribute></optional><ref name="simpleElement"/></element></define>
  <define name="toctitle"><element name="toctitle"><ref name="simpleElement"/></element></define>
  <define name="linktitle"><element name="linktitle"><ref name="simpleElement"/></element></define>
  <define name="breadcrumbtitle"><element name="breadcrumbtitle"><ref name="simpleElement"/></element></define>
  <define name="nofirstline"><element name="nofirstline"><ref name="simpleElement"/></element></define>
  <define name="keywords"><element name="keywords"><ref name="simpleElement"/></element></define>
  <define name="dates"><element name="dates"><ref name="simpleElement"/></element></define>
  <define name="published"><element name="published"><ref name="simpleElement"/></element></define>
  <define name="written"><element name="written"><ref name="simpleElement"/></element></define>
  <define name="performed"><element name="performed"><ref name="simpleElement"/></element></define>
  <define name="event"><element name="event"><ref name="simpleElement"/></element></define>
  <define name="begivenhed"><element name="begivenhed"><ref name="simpleElement"/></element></define>
  <define name="notes"><element name="notes"><ref name="simpleElement"/></element></define>
  <define name="quality"><element name="quality"><ref name="simpleElement"/></element></define>
  <define name="metre">
    <element name="metre">
      <oneOrMore><ref name="metreAnalysis"/></oneOrMore>
    </element>
  </define>
  <define name="metreAnalysis">
    <element name="analysis">
      <attribute name="pattern"><text/></attribute>
      <attribute name="confidence">
        <data type="decimal">
          <param name="minInclusive">0</param>
          <param name="maxInclusive">1</param>
        </data>
      </attribute>
      <empty/>
    </element>
  </define>
  <define name="rhyme">
    <element name="rhyme">
      <oneOrMore><ref name="rhymeAnalysis"/></oneOrMore>
    </element>
  </define>
  <define name="syllables">
    <element name="syllables">
      <oneOrMore><ref name="syllablesAnalysis"/></oneOrMore>
    </element>
  </define>
  <define name="syllablesAnalysis">
    <element name="analysis">
      <attribute name="pattern"><text/></attribute>
      <attribute name="confidence">
        <data type="decimal">
          <param name="minInclusive">0</param>
          <param name="maxInclusive">1</param>
        </data>
      </attribute>
      <empty/>
    </element>
  </define>
  <define name="rhymeAnalysis">
    <element name="analysis">
      <attribute name="pattern"><text/></attribute>
      <attribute name="confidence">
        <data type="decimal">
          <param name="minInclusive">0</param>
          <param name="maxInclusive">1</param>
        </data>
      </attribute>
      <empty/>
    </element>
  </define>
  <define name="structure">
    <element name="structure">
      <element name="analysis">
        <attribute name="pattern">
          <data type="string">
            <param name="pattern">[1-9][0-9]*(-[1-9][0-9]*)*</param>
          </data>
        </attribute>
        <attribute name="confidence">
          <data type="decimal">
            <param name="minInclusive">0</param>
            <param name="maxInclusive">1</param>
          </data>
        </attribute>
        <empty/>
      </element>
    </element>
  </define>
  <define name="pagebreaks"><element name="pagebreaks"><empty/></element></define>
  <define name="pictures"><element name="pictures"><ref name="simpleElement"/></element></define>
  <define name="inlineWithoutLineMarkers">
    <zeroOrMore>
      <choice>
        <text/>
        <ref name="a"/>
        <ref name="xref"/>
        <ref name="b"/>
        <ref name="i"/>
        <ref name="span"/>
        <ref name="sc"/>
        <ref name="small"/>
        <ref name="sup"/>
        <ref name="s"/>
        <ref name="u"/>
        <ref name="num"/>
        <ref name="resetnum"/>
        <ref name="margin"/>
        <ref name="metrik"/>
        <ref name="line"/>
        <ref name="br"/>
        <ref name="hr"/>
        <ref name="pb"/>
        <ref name="img"/>
        <ref name="colored"/>
        <ref name="note"/>
        <ref name="footnote"/>
        <ref name="biblio"/>
        <ref name="asterism"/>
        <ref name="block-center"/>
        <ref name="two-columns"/>
        <ref name="column"/>
        <ref name="w"/>
        <ref name="wrap"/>
      </choice>
    </zeroOrMore>
  </define>

  <define name="b"><element name="b"><ref name="inlineWithoutLineMarkers"/></element></define>
  <define name="i">
    <element name="i">
      <optional><attribute name="lang"><text/></attribute></optional>
      <ref name="inlineWithoutLineMarkers"/>
    </element>
  </define>
  <define name="span">
    <element name="span">
      <optional><attribute name="lang"><text/></attribute></optional>
      <ref name="inlineWithoutLineMarkers"/>
    </element>
  </define>
  <define name="sc"><element name="sc"><ref name="inlineWithoutLineMarkers"/></element></define>
  <define name="small">
    <element name="small">
      <optional><attribute name="lang"><text/></attribute></optional>
      <ref name="inlineWithoutLineMarkers"/>
    </element>
  </define>
  <define name="sup"><element name="sup"><ref name="simpleElement"/></element></define>
  <define name="s"><element name="s"><ref name="simpleElement"/></element></define>
  <define name="u"><element name="u"><ref name="simpleElement"/></element></define>
  <define name="num"><element name="num"><ref name="simpleElement"/></element></define>
  <define name="nonum">
    <element name="nonum">
      <choice>
        <ref name="inlineWithoutLineMarkers"/>
        <ref name="center"/>
        <ref name="right"/>
      </choice>
    </element>
  </define>
  <define name="resetnum"><element name="resetnum"><ref name="simpleElement"/></element></define>
  <define name="center"><element name="center"><ref name="inlineWithoutLineMarkers"/></element></define>
  <define name="right">
    <element name="right">
      <optional><attribute name="lang"><text/></attribute></optional>
      <ref name="inlineWithoutLineMarkers"/>
    </element>
  </define>
  <define name="margin"><element name="margin"><ref name="simpleElement"/></element></define>
  <define name="metrik"><element name="metrik"><ref name="simpleElement"/></element></define>
  <define name="wrap"><element name="wrap"><ref name="inlineWithoutLineMarkers"/></element></define>
  <define name="line">
    <element name="line">
      <optional><attribute name="lang"><text/></attribute></optional>
      <ref name="simpleElement"/>
    </element>
  </define>
  <define name="br"><element name="br"><ref name="simpleElement"/></element></define>
  <define name="footnote"><element name="footnote"><ref name="simpleElement"/></element></define>
  <define name="biblio"><element name="biblio"><ref name="simpleElement"/></element></define>
  <define name="asterism"><element name="asterism"><ref name="simpleElement"/></element></define>
  <define name="block-center"><element name="block-center"><ref name="simpleElement"/></element></define>
  <define name="two-columns"><element name="two-columns"><ref name="simpleElement"/></element></define>
  <define name="column"><element name="column"><ref name="simpleElement"/></element></define>
  <define name="w">
    <element name="w">
      <optional><attribute name="lang"><text/></attribute></optional>
      <ref name="inlineWithoutLineMarkers"/>
    </element>
  </define>
</grammar>
